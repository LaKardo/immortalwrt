Subject: [PATCH] mtd: spinand: fix FM25G02B ECC and quad read on U-Boot 2025.10

Adapt the FM25G02B fixes from ImmortalWrt commit 72f1965140 to the
older FMSH driver supplied by patch 342. Do not duplicate the chip ID.

--- a/drivers/mtd/nand/spi/fmsh.c
+++ b/drivers/mtd/nand/spi/fmsh.c
@@ -164,6 +164,29 @@
+static SPINAND_OP_VARIANTS(fm25g_read_cache_variants,
+		SPINAND_PAGE_READ_FROM_CACHE_QUADIO_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_X4_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_DUALIO_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_X2_OP(0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_OP(true, 0, 1, NULL, 0),
+		SPINAND_PAGE_READ_FROM_CACHE_OP(false, 0, 1, NULL, 0));
+
+static int fm25g02b_ecc_get_status(struct spinand_device *spinand,
+				u8 status)
+{
+	u8 eccsr = (status & GENMASK(6, 4)) >> 4;
+
+	if (eccsr == 0)
+		return 0;
+	if (eccsr == 1)
+		return 3;
+	if (eccsr == 7)
+		return -EBADMSG;
+
+	return eccsr + 2;
+}
+
 static int fm25g02b_ooblayout_ecc(struct mtd_info *mtd, int section,
 				  struct mtd_oob_region *region)
 {
-	if (section >= 8)
+	if (section)
 		return -ERANGE;
 
@@ -170,2 +193,2 @@
-	region->offset = 64 + section * 8;
-	region->length = 8;
+	region->offset = 64;
+	region->length = 64;
@@ -248,9 +271,10 @@
 	SPINAND_INFO("FM25G02B",
 		     SPINAND_ID(SPINAND_READID_METHOD_OPCODE_DUMMY, 0xD2),
-		     NAND_MEMORG(1, 2048, 128, 64, 2048, 40, 1, 1, 1),
+		     NAND_MEMORG(1, 2048, 128, 64, 2048, 41, 1, 1, 1),
 		     NAND_ECCREQ(8, 528),
-		     SPINAND_INFO_OP_VARIANTS(&read_cache_variants,
+		     SPINAND_INFO_OP_VARIANTS(&fm25g_read_cache_variants,
 					      &write_cache_variants,
 					      &update_cache_variants),
 		     SPINAND_HAS_QE_BIT,
-		     SPINAND_ECCINFO(&fm25g02b_ooblayout, NULL)),
+		     SPINAND_ECCINFO(&fm25g02b_ooblayout,
+				     fm25g02b_ecc_get_status)),
